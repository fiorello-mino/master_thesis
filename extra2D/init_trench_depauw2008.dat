info:                                                   100

dimension of world:                                          2
smallest number:                                             1.e-6

name:	surf
#include "init/config.ini"

degree:                                                      10

axis->x:                                                     [ 1, 1, 0]
axis->y:                                                     [ -1, 1, 0]
axis->z:                                                     [ 0, 0, 1]

surf->space->components:                                2
surf->space->components->phi:				1	% 1->Yes
surf->space->components->mu:			1	% 1->Yes
surf->space->components->kappa:			0	% 1->Yes
surf->space->name:					[phi,mu]

#############################################################################################
#	CUSTOM
surf->stabilizing function for mu:			1	% 1->Yes 0->No
surf->eps:                                              0.0260416

#       BC
surf->boundary conditions->Periodic BC:			  [ -1 ]
surf->boundary conditions->contact angle->boundary index: [ ]
surf->boundary conditions->contact angle->theta:          [ ] % degree

#       PHYSICS
surf->physics->energy->gamma:				1
surf->physics->energy->gamma->anisotropy->mode:             no
    surf->physics->energy->gamma->anisotropy->output:        ani_gamma.dat
    surf->physics->energy->gamma->anisotropy->baseline:      1.
% ms -> gamma=MS function(n)
    surf->physics->energy->gamma->anisotropy->ms->file:      init/GammaGe_abs.dat
    surf->physics->energy->gamma->anisotropy->ms->absolute values:             1

surf->physics->energy->corner:				0.

surf->physics->mobility:				5e-5


surf->physics->ac->k:					0
surf->growth->rate:                                     0.
surf->growth->flux distribution:                        0       % 0-Isotropic 1-Directional
surf->growth->flux direction:                           [ 0, 0, -1 ]
surf->growth->anisotropy:                               no %init/cube.dat   % Specify file name or 0->No

############################################################################################
#############################################################################################
#       PHI
 
surf->phi->mode:                                shape % external file , constant
surf->phi->external file:             init/test.arh
surf->phi->constant:                            1.
 
surf->phi->shape:                               rectangle + rectangle1 + rectangle2 + rectangle3 + rectangle4 + rectangle5 + rectangle6 + rectangle7 + rectangle8 + rectangle9 + rectangle10 + rectangle11 + rectangle12 + rectangle13 + rectangle14 + rectangle15 + rectangle16 + rectangle17 + rectangle18 + rectangle19 + rectangle20
surf->phi->shape->inner value:                  0
surf->phi->shape->outer value:                  1
surf->phi->shape->center:             [ 0. , 0. ]
 
surf->phi->shape->eps:                          ${surf->eps}
 
#  Trench array da Depauw et al., Thin Solid Films 516 (2008) 6934, Fig. 2c (trench litografici prima dell'annealing), misure di Fiorello: 20 trench in 18.6 um, w=0.45 um, D=5 um
#  larghezza w = 5 eps = 0.130208 | passo p = 0.93 um riscalato = 0.2690965 | profondita D = 5 um riscalato = 1.4467556 (AR = 5/0.45 = 11.1)
#  dominio: x in [-2.6909653, 2.6909653] (Lx = 5.3819307 = 20 p), y in [-1.1140018, 1.1140018] (Ly = 2.2280036)
#  superficie a y = 0.7233778, fondo dei trench a y = -0.7233778
 
rectangle->sides length: [5.5819307,0.6]
rectangle->center:       [0.0,1.0233778]

rectangle1->sides length:  [0.130208,1.550922]
