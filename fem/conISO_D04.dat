info:                                                   100

dimension of world:                                          3
smallest number:                                             1.e-6

name:	surf
#include "init/config.ini"

degree:                                                      10

axis->x:                                                     [ 1, 1, 0]
axis->y:                                                     [ -1, 1, 0]
axis->z:                                                     [ 0, 0, 1]

surf->space->components:                                2
surf->space->components->phi:				1	% 1->Yes
surf->space->components->mu:			1	% 1->Yes
surf->space->components->kappa:			0	% 1->Yes
surf->space->name:					[phi,mu,kappa]

#############################################################################################
#	CUSTOM
surf->stabilizing function for mu:			1	% 1->Yes 0->No
surf->eps:                                              0.1

#       BC
surf->boundary conditions->Periodic BC:			  [ ]
surf->boundary conditions->contact angle->boundary index: [ ]
surf->boundary conditions->contact angle->theta:          [ ] % degree

#       PHYSICS
surf->physics->energy->gamma:				6.6
surf->physics->energy->gamma->anisotropy->mode:             no
    surf->physics->energy->gamma->anisotropy->output:        ani_gamma.dat
    surf->physics->energy->gamma->anisotropy->baseline:      1.
% ms -> gamma=MS function(n)
    surf->physics->energy->gamma->anisotropy->ms->file:      init/GammaGe_Bermond.dat
    surf->physics->energy->gamma->anisotropy->ms->absolute values:             1

surf->physics->energy->corner:				0.00

surf->physics->mobility:				1.e-2


surf->physics->ac->k:					0
surf->growth->rate:                                     0.
surf->growth->flux distribution:                        0       % 0-Isotropic 1-Directional
surf->growth->flux direction:                           [ 0, 0, -1 ]
surf->growth->anisotropy:                               no %init/cube.dat   % Specify file name or 0->No

############################################################################################
#############################################################################################
#       PHI

surf->phi->mode:                                shape % external file , constant
surf->phi->external file:          		init/test.arh
surf->phi->constant:                            1.		 

surf->phi->shape:                               trunkcone + -plane

surf->phi->shape->inner value:                  1
surf->phi->shape->outer value:                  0
surf->phi->shape->center:		        [ 0. , 0., 0. ]

surf->phi->shape->eps:                          ${surf->eps}

trunkcone:	cone * -plane1

rtop:			0.2
rbot:			0.1
h:                      2.05

%tana:	${h}/(${rtop}-${rbot})
tana:	18.6363

dy:	${surf->eps}

rc:	${rtop} + ${dy}/${tana}
hc:	${rtop}*${tana} + ${dy}

cone->radius: 			${rc}
cone->height: 			${hc}
cone->center:			[0, 0, ${dy} ]
cone->rotation->angle:		180.
cone->rotation->axis:		[1,0,0]


plane1->normal vector:           [0, 0, 1]
plane1->offset:                  -${h}


plane->normal vector:           [0, 0, 1]
plane->offset:                  0.

#############################################################################################
surf->phi->signed distance:		                                1          % 1->Yes 0->No
surf->phi->signed distance->tolerance: 				        1.e-4
surf->phi->signed distance->maximal number of iteration steps: 	        100
surf->phi->signed distance->Gauss-Seidel iteration: 			1
surf->phi->signed distance->infinity value: 				1.e8
surf->phi->signed distance->boundary initialization: 			3

#	LOCAL REFINEMENT
surf->phi->refinement:                      		pf     % grad, pf
surf->phi->refinement->pf->level in outer domain: 	1
surf->phi->refinement->pf->level on interface: 		8
surf->phi->refinement->pf->level on points: 		8
surf->phi->refinement->pf->level in inner domain: 	1
surf->phi->refinement->pf->initial level:               4
surf->phi->refinement->pf->min interface value:		0.05    % Default=0.05
surf->phi->refinement->pf->max interface value:		0.95    % Default=0.95

#############################################################################################
#	OUTPUT
output->directory:                                      conISO_D04
surf->output->filename:                                 surf
surf->output->check:                                    check
surf->output->physics:                                  phys
surf->output->last:	                                last
surf->output->last->iterations:                  100

surf->output->write every i-th timestep:         10
surf->output->ParaView format:                          1
surf->output->ParaView animation:                       1
surf->output->append index:                             1
surf->output->index length:                             7
surf->output->index decimals:                           6
surf->output->ARH format:                               0
surf->output->ARH2 format:                              0
surf->output->ARH3 format:                              0
surf->output->AMDiS format:                             0

#############################################################################################
#############################################################################################
#	MESH
surf->space->mesh:					surfMesh

surfMesh->macro file name:				./macro/trench_4_4_60.3d

surfMesh->refinement->initial->coarsen allow:         1
surfMesh->refinement->initial->repartition allow:     1
surfMesh->refinement->coarsen allow:                  1
surfMesh->refinement->repartition allow:              0
surfMesh->refinement->initial level:                  2
surfMesh->refinement->global level:                   2

############################################################################################
#	SOLVER
surf->space->solver:					umfpack
surf->space->solver->ell:                               4
surf->space->solver->max iteration:			1000
surf->space->solver->tolerance:				1.e-8
surf->space->solver->info:				20
surf->space->solver->left precon:			diag
surf->space->solver->right precon:			no

#############################################################################################
surf->space->dim:                                       ${dimension of world}

surf->space->polynomial degree[0]:			1
surf->space->polynomial degree[1]:			1
surf->space->polynomial degree[2]:			1
surf->space->polynomial degree[3]:			1

surf->space->marker[0]->strategy:    			0  % 0=none, 1=GR, 2=MS, 3=ES, 4=GERS
surf->space->marker[0]->MSGamma:     			0.5
surf->space->marker[0]->MSGammaC:    			0.1

surf->space->marker[1]->strategy:    			0  % 0=none, 1=GR, 2=MS, 3=ES, 4=GERS

surf->space->marker[2]->strategy:    			0  % 0=none, 1=GR, 2=MS, 3=ES, 4=GERS

surf->space->marker[3]->strategy:    			0  % 0=none, 1=GR, 2=MS, 3=ES, 4=GERS

#############################################################################################
#	ESTIMATOR
surf->space->estimator[0]:				0
surf->space->estimator[0]->C0:				1.0
surf->space->estimator[0]->C1:				1.0
surf->space->estimator[0]->C3:				1.0

surf->space->estimator[1]:				0

surf->space->estimator[2]:				0

surf->space->estimator[3]:				0

#############################################################################################
#	ADAPT
surf->adapt->timestep:					1.e-4
surf->adapt->start time:				0.0
surf->adapt->end time:					1.

surf->adapt->strategy:                                  3  % 0=explicit, 1=implicit
surf->adapt->max iteration:                             100
surf->adapt->max timestep:                              1.e-4
surf->adapt->min timestep:                              1.e-6
surf->adapt->relative energy tolerance:         1.e-6
surf->adapt->time delta 1:                       0.5          % DEFAULT=0.7071
surf->adapt->time delta 2:                       1.5

surf->adapt->end if no evolution:                               1
surf->adapt->end if no evolution->num iterations:               20
surf->adapt->end if no evolution->relative energy tolerance:    5.e-6
surf->adapt->end if no evolution->L2 phi tolerance:     1.e-4
surf->adapt->end if no evolution->LInf phi tolerance:   1.e-4


surf->adapt->strategy:					0  % 0=explicit, 1=implicit
surf->adapt->max iteration:				100

surf->adapt[0]->tolerance:				0.05
surf->adapt[0]->time tolerance:				0.05

surf->adapt[1]->tolerance:				0.05
surf->adapt[1]->time tolerance:				0.05

surf->adapt[2]->tolerance:				0.05
surf->adapt[2]->time tolerance:				0.05

surf->adapt[3]->tolerance:				0.05
surf->adapt[3]->time tolerance:				0.05


WAIT:							0
